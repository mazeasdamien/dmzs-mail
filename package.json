{
  "name": "dmzs-mail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/check-client.mjs && node test.mjs && wrangler deploy",
    "db:schema": "wrangler d1 execute dmzs-mail --remote --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute dmzs-mail --local --file=./schema.sql",
    "secrets": "node scripts/secrets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "agent": "powershell -NoProfile -ExecutionPolicy Bypass -File agent/run.ps1",
    "tail": "wrangler tail",
    "test": "node test.mjs",
    "check": "node scripts/check-client.mjs && node test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
